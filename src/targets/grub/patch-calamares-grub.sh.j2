#!/bin/bash

set -xe

CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")

# Install luks utilities if needed.
# Also, set secure permissions for the initramfs if we're configuring
# full-disk-encryption. The initramfs is re-generated later in the
# installation process so we only set the permissions snippet without
# regenerating the initramfs right now:
if [ "$(mount | grep $CHROOT" " | cut -c -16)" = "/dev/mapper/luks" ]; then
    echo "UMASK=0077" > $CHROOT/etc/initramfs-tools/conf.d/initramfs-permissions
    chroot $CHROOT apt-get -y install cryptsetup-initramfs cryptsetup keyutils
fi

echo "Running bootloader-config..."

if [ -d /sys/firmware/efi/efivars ]; then
    echo " * Installing grub-efi (uefi)..."
    DEBIAN_FRONTEND=noninteractive chroot $CHROOT apt-get -y install grub-efi
else
    echo " * install grub... (bios)"
    DEBIAN_FRONTEND=noninteractive chroot $CHROOT apt-get -y install grub-pc
fi

# =================== Poly Dark Theme ======================
# refer to
# https://github.com/shvchk/poly-dark/blob/master/install.sh
# Also see - https://github.com/hashirsajid58200p/forest-dawn-grub-theme/tree/main
GRUB_THEME='poly-dark'
# Detect distro and set GRUB location and update method
GRUB_DIR='grub'
UPDATE_GRUB=''
BOOT_MODE='legacy'
GRUB_THEME_PATH="{{ grub_theme_path }}"

if [[ -d /boot/efi && -d /sys/firmware/efi ]]; then
    BOOT_MODE='UEFI'
fi

echo "Boot mode: ${BOOT_MODE}"

echo 'Creating GRUB themes directory'
mkdir -p $CHROOT/boot/${GRUB_DIR}/themes/${GRUB_THEME}

echo 'Copying theme to GRUB themes directory'
tar -xzf $GRUB_THEME_PATH --strip-components=1 -C ${CHROOT}/boot/${GRUB_DIR}/themes/${GRUB_THEME}

echo 'Removing other themes from GRUB config'
sed -i '/^GRUB_THEME=/d' $CHROOT/etc/default/grub

echo 'Making sure GRUB uses graphical output'
sed -i 's/^\(GRUB_TERMINAL\w*=.*\)/#\1/' $CHROOT/etc/default/grub

echo 'Removing empty lines at the end of GRUB config' # optional
sed -i -e :a -e '/^\n*$/{$d;N;};/\n$/ba' $CHROOT/etc/default/grub

echo 'Adding new line to GRUB config just in case' # optional
echo | tee -a $CHROOT/etc/default/grub

echo 'Adding theme to GRUB config'
echo "GRUB_THEME=/boot/${GRUB_DIR}/themes/${GRUB_THEME}/theme.txt" | tee -a $CHROOT/etc/default/grub

echo 'Adding new line to GRUB config just in case' # optional
echo | tee -a $CHROOT/etc/default/grub

# This is important as loading kernel/initfs screen relies on background
# Theme background won't take effect in this stage.
echo 'Adding background to GRUB config'
echo "GRUB_BACKGROUND=/boot/${GRUB_DIR}/themes/${GRUB_THEME}/background.png" | tee -a $CHROOT/etc/default/grub

# ====================================================

# Re-enable os-prober:
sed -i "s/#GRUB_DISABLE_OS_PROBER=false/# OS_PROBER re-enabled by Debian Calamares installation:\nGRUB_DISABLE_OS_PROBER=false/g" $CHROOT/etc/default/grub
chroot $CHROOT /usr/sbin/update-grub

# Remove the them tarball from chroot as it's not expected in installed system
echo 'Remove theme tarball'
rm ${CHROOT}$GRUB_THEME_PATH
